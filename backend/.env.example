# Configuração do Servidor
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Ative para visualizar todas as queries SQL do Prisma no terminal (default: false/silencioso)
DEBUG_PRISMA=false

# Chave Secreta para JWT da Diretoria (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="substitua_por_uma_chave_hex_aleatoria_de_64_caracteres"

# Chave de Segurança exigida no cadastro de novos Administradores (/admin/register)
# Se deixada em branco, a rota /api/auth/register fica desabilitada por segurança.
ADMIN_REGISTRATION_KEY="substitua_por_uma_chave_secreta_exclusiva_da_diretoria"

# Credenciais iniciais do Administrador para execução do seed (npx prisma db seed)
ADMIN_EMAIL="admin@meldinafc.com"
ADMIN_INITIAL_PASSWORD="defina_uma_senha_forte_com_minimo_8_caracteres"

# Conexão Principal com o PostgreSQL do Supabase (prefira o Session Pooler IPv4 para funcionar no Docker)
# IMPORTANTE: Caso a senha contenha caracteres especiais como '@', substitua por '%40'
DATABASE_URL="postgresql://postgres.seu_projeto:sua_senha_url_encoded@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Conexão de Fallback para o PostgreSQL Local (usada automaticamente se o Supabase falhar)
LOCAL_DATABASE_URL="postgresql://postgres:meldina_postgres_local@localhost:5432/meldina_fc?schema=public"

# Origens permitidas para requisições do Frontend (separe por vírgula se houver mais de uma)
CORS_ORIGIN="http://localhost:3000"

# =========================================================================
# CONFIGURAÇÃO DE STORAGE DO SUPABASE (Opcional - Usado em Produção/Nuvem)
# =========================================================================
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-secreta-aqui"
SUPABASE_STORAGE_BUCKET="meldina-assets"
