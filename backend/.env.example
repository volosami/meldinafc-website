# Configuração do Servidor
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Ative para visualizar todas as queries SQL do Prisma no terminal (default: false/silencioso)
DEBUG_PRISMA=false

# Chave Secreta para JWT da Diretoria
JWT_SECRET=meldina-super-secret-jwt-key-2026

# Chave de Segurança exigida no cadastro de novos Administradores (/admin/register)
ADMIN_REGISTRATION_KEY="meldina-admin-2026-secret"

# Conexão com o PostgreSQL do Supabase (Transaction/Session Pooler ou Direct URL)
# Exemplo Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:sua_senha@seu_host.supabase.co:5432/postgres?sslmode=require"

# Origem permitida para requisições do Frontend
CORS_ORIGIN="http://localhost:3000"

# =========================================================================
# CONFIGURAÇÃO DE STORAGE DO SUPABASE (Opcional - Usado em Produção/Nuvem)
# =========================================================================
# Se configuradas abaixo, os uploads de imagens serão enviados diretamente
# para o Bucket do Supabase Storage. Se omitidas, as imagens são salvas
# localmente na pasta /public/uploads do backend.
#
# URL base do seu projeto Supabase (disponível em Settings > API):
SUPABASE_URL="https://seu-projeto.supabase.co"
# Chave Service Role (Settings > API > Project API keys > service_role secret):
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-aqui"
# Nome do Bucket de Storage no Supabase (crie como público):
SUPABASE_STORAGE_BUCKET="meldina-assets"
