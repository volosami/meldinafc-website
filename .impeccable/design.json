      "css": ".ds-field{display:flex;flex-direction:column;gap:6px}.ds-field span{font-family:Poppins,sans-serif;font-size:0.72rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.7)}.ds-field input{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:4px;padding:13px 14px;color:#fff;font-family:Poppins,sans-serif;font-size:0.95rem;transition:border-color .2s,background .2s}.ds-field input::placeholder{color:rgba(255,255,255,0.35)}.ds-field input:focus{outline:none;border-color:#efaa19;background:rgba(255,255,255,0.08)}"
