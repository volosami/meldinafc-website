      "css": ".ds-nav{display:flex;gap:4px;background:rgba(4,7,32,0.95);padding:16px}.ds-nav a{position:relative;padding:10px 12px;font-family:Poppins,sans-serif;font-weight:600;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.82);text-decoration:none;transition:color .2s}.ds-nav a::after{content:'';position:absolute;left:12px;right:12px;bottom:4px;height:2px;background:#efaa19;transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(0.2, 0.7, 0.1, 1)}.ds-nav a:hover,.ds-nav a.is-active{color:#fff}.ds-nav a:hover::after,.ds-nav a.is-active::after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:2px solid #efaa19;outline-offset:3px}"
    }
